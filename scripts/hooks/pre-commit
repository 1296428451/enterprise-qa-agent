#!/bin/sh
# Optional local Git hook. Enable with: git config core.hooksPath scripts
# It only inspects staged content and never prints credential values.
set -e
REPO_ROOT=$(git rev-parse --show-toplevel)
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-commit: python not found, skipping credential check" >&2
  exit 0
fi
exec "$PY" "$REPO_ROOT/scripts/check_secrets.py" --staged-only
